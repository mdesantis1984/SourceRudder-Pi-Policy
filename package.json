{
  "name": "pi-sourcerudder-policy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SourceRudder-first web-research policy extension for Pi",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "sourcerudder",
    "policy"
  ],
  "files": [
    "src",
    "README.es.md",
    "RUNBOOK.md",
    "RUNBOOK.es.md",
    "docs/architecture.md",
    "docs/architecture.es.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check:package": "node scripts/check-package.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify:installed": "node scripts/verify-installed.mjs",
    "check": "npm run typecheck && npm test && npm run check:package && npm run check:docs && npm run verify:installed"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "22.20.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
